# Environment variables for the Node.js build (Hostinger → Triển khai → Biến môi trường).
# Copy to .env.local for local development. Never commit real values.

# Stripe Dashboard → Developers → API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Set to "true" only after enabling Stripe Tax in your Stripe Dashboard.
STRIPE_TAX=false

SITE_URL=https://ideaburstflowers.com

# Hostinger email (hPanel → Emails). Used to send contact / event / review emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@ideaburstflowers.com
SMTP_PASS=REPLACE_ME
MAIL_FROM=no-reply@ideaburstflowers.com
MAIL_TO=contact@ideaburstflowers.com
